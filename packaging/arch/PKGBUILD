# Maintainer: nathawat <nathawat[at]noreply[dot]codeberg[dot]org>

pkgname=platform-profile-daemon
pkgver=1.0.0
pkgrel=1
pkgdesc="Minimal Power Profiles D-Bus daemon backed kernel ACPI platform profile"
arch=('x86_64')
url="https://codeberg.org/nathawat/platform-profile-daemon"
license=('Apache-2.0')
depends=('dbus' 'polkit' 'systemd')
provides=('power-profiles-daemon')
conflicts=('power-profiles-daemon')
makedepends=('git' 'pkgconf' 'systemd' 'zig')
_tag="v${pkgver}"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/${_tag}.tar.gz")
b2sums=("5acca3226d6629b0fec40e23ba955baf3dc68f95d2da7bd65f8e22160ed9af3213580e1ed3301689f3a5c92697ad3bb7ba7d881991a05ac15cd2922c9ad3a046")

build() {
    cd "${srcdir}/${pkgname}"
    zig build -Doptimize=ReleaseFast
}

check() {
    cd "${srcdir}/${pkgname}"
    zig build test
}

package() {
    cd "${srcdir}/${pkgname}"
    DESTDIR="${pkgdir}" zig build -Doptimize=ReleaseFast --prefix /usr
}
