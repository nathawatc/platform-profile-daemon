[Unit]
Description=Minimal Platform Profile Daemon
Documentation=https://codeberg.org/nathawat/platform-profile-daemon
Conflicts=power-profiles-daemon.service

[Service]
Type=dbus
BusName=org.freedesktop.UPower.PowerProfiles
ExecStart=/usr/bin/platform-profile-daemon
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/sys/firmware/acpi/platform_profile

[Install]
WantedBy=multi-user.target
Alias=power-profiles-daemon.service
